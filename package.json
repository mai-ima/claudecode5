{
  "name": "claudecode5-tetris",
  "version": "0.1.0",
  "description": "拡張性・保守性・統合性を重視した本格的テトリス（+ ぷよぷよモード/対戦/模擬ストア）",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "typecheck:server": "tsc --noEmit -p server/tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck:api": "tsc --noEmit -p api/tsconfig.json",
    "server": "tsx server/index.ts",
    "verify": "npm run lint && npm run typecheck && npm run typecheck:api && npm run typecheck:server && npm run test && npm run build",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "keywords": ["tetris", "puyo", "game", "canvas", "typescript"],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "@vercel/node": "^5.0.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.13.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.3",
    "vite-plugin-pwa": "^0.21.1",
    "vite-plugin-solid": "^2.11.0",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@vercel/kv": "^3.0.0",
    "solid-js": "^1.9.3",
    "ws": "^8.18.0"
  }
}
